<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.wifi</string>
	<!-- The Redmi K20 Pro's version of the job (build.sh picks it for DEVICE=raphael). It does not configure the
	     interface itself (no "wifi" step): a few minutes into the run, after you have joined a network in Settings, it
	     says what the system did on its own: the addresses, configd's dynamic store, what SCNetworkReachability says,
	     a lookup and an HTTPS fetch. -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/net_test</string>
		<string>wait</string>
		<string>200</string>
		<string>show</string>
		<string>store</string>
		<string>reach</string>
		<string>www.apple.com</string>
		<string>reach</string>
		<string>example.com</string>
		<string>reach</string>
		<string>8.8.8.8</string>
		<string>ftype</string>
		<string>en0</string>
		<string>services</string>
		<string>ct</string>
		<string>6</string>
		<string>nwpath</string>
		<string>8</string>
		<string>resolve</string>
		<string>www.apple.com</string>
		<string>fetch</string>
		<string>https://www.apple.com/library/test/success.html</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
